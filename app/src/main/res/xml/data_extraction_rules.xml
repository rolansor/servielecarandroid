<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de extracción de datos (Android 12+): respaldo en la nube y
    transferencia entre dispositivos. Se excluye todo lo sensible en ambos casos;
    ver backup_rules.xml para el detalle del criterio.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="serviaux" />
        <exclude domain="database" path="serviaux-shm" />
        <exclude domain="database" path="serviaux-wal" />
        <exclude domain="sharedpref" path="dropbox_prefs.xml" />
        <exclude domain="sharedpref" path="serviaux_session.xml" />
        <exclude domain="file" path="vehicle_photos/" />
        <exclude domain="file" path="work_order_files/" />
        <exclude domain="file" path="reports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="serviaux" />
        <exclude domain="database" path="serviaux-shm" />
        <exclude domain="database" path="serviaux-wal" />
        <exclude domain="sharedpref" path="dropbox_prefs.xml" />
        <exclude domain="sharedpref" path="serviaux_session.xml" />
        <exclude domain="file" path="vehicle_photos/" />
        <exclude domain="file" path="work_order_files/" />
        <exclude domain="file" path="reports/" />
    </device-transfer>
</data-extraction-rules>
