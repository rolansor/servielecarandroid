<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de Auto Backup. Hoy el respaldo del sistema está desactivado
    (android:allowBackup="false" en el manifest) porque la app tiene su propio
    mecanismo de respaldo (ZIP + Dropbox). Estas exclusiones se mantienen como
    segunda barrera por si alguna vez se reactiva.

    Nada que contenga credenciales ni datos de clientes debe salir del dispositivo:
    - database: la base de datos completa.
    - sharedpref: token de Dropbox (refresh token) y sesión del usuario.
    - file: fotos de vehículos y órdenes, adjuntos y PDFs generados.
-->
<full-backup-content>
    <exclude domain="database" path="serviaux" />
    <exclude domain="database" path="serviaux-shm" />
    <exclude domain="database" path="serviaux-wal" />
    <exclude domain="sharedpref" path="dropbox_prefs.xml" />
    <exclude domain="sharedpref" path="serviaux_session.xml" />
    <exclude domain="file" path="vehicle_photos/" />
    <exclude domain="file" path="work_order_files/" />
    <exclude domain="file" path="reports/" />
</full-backup-content>
